{
  "name": "@supergit/nicifier",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm",
    "prepack": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
